{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openframe.dev/schemas/canvas/v1/canvas.schema.json",
  "title": "Openframe canvas document v1",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "pages",
    "nodes",
    "tokens",
    "components",
    "export_metadata",
    "unsupported_elements"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "pages": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "tokens": { "type": "array" },
    "components": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "export_metadata": { "type": "object" },
    "unsupported_elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field_path", "node_kind"],
        "properties": {
          "field_path": { "type": "string" },
          "node_kind": { "type": "string" },
          "raw": {}
        }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "kind", "name", "children"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "enum": ["page", "frame", "group", "vector", "text", "component", "instance", "token_collection", "export_metadata"]
        },
        "name": { "type": "string" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    }
  }
}
