{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Openframe",
  "version": "0.1.0",
  "identifier": "com.openframe.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Openframe",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": ["icons/icon.png"]
  }
}
